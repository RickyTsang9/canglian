# Canglian ERP 生产环境启动环境变量模板
# 启动示例：java -jar canglian-admin.jar --spring.profiles.active=druid,prod

SERVER_PORT=7565
CANGLIAN_PROFILE=/data/canglian/uploadPath

# 数据库配置（请务必修改为强口令）
MYSQL_URL=jdbc:mysql://127.0.0.1:3306/canglian?characterEncoding=utf-8&useSSL=true&serverTimezone=Asia/Shanghai
MYSQL_USERNAME=canglian_app
MYSQL_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# JWT 令牌密钥（生产环境强制要求长度 >= 32 字节的随机字符串）
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_RANDOM_SECRET_KEY_2026
JWT_EXPIRE_MINUTES=30

# 安全加固开关
ENFORCE_CAPTCHA=true
FORCE_PASSWORD_CHANGE=true
SWAGGER_ENABLED=false
DEVTOOLS_ENABLED=false
DRUID_STAT_VIEW_ENABLED=false
DRUID_ALLOW=127.0.0.1
DRUID_USERNAME=canglian_druid
DRUID_PASSWORD=REPLACE_WITH_STRONG_DRUID_PASSWORD
REFERER_ENABLED=true
ALLOWED_DOMAINS=erp.example.com
LOG_LEVEL=info
