<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.WmsPurchaseReturnMapper">

    <resultMap type="WmsPurchaseReturn" id="WmsPurchaseReturnResult">
        <id     property="purchaseReturnId" column="purchase_return_id" />
        <result property="returnNo"         column="return_no"          />
        <result property="returnType"       column="return_type"        />
        <result property="supplierId"       column="supplier_id"        />
        <result property="warehouseId"      column="warehouse_id"       />
        <result property="deptId"           column="dept_id"            />
        <result property="ownerUserId"      column="owner_user_id"      />
        <result property="sourceBillType"   column="source_bill_type"   />
        <result property="sourceBillId"     column="source_bill_id"     />
        <result property="sourceBillNo"     column="source_bill_no"     />
        <result property="businessDate"     column="business_date"      />
        <result property="totalQty"         column="total_qty"          />
        <result property="totalAmount"      column="total_amount"       />
        <result property="payableId"        column="payable_id"         />
        <result property="status"           column="status"             />
        <result property="bizStatus"        column="biz_status"         />
        <result property="auditBy"          column="audit_by"           />
        <result property="auditTime"        column="audit_time"         />
        <result property="isReversal"       column="is_reversal"        />
        <result property="originBillId"     column="origin_bill_id"     />
        <result property="reversedFlag"     column="reversed_flag"      />
        <result property="unauditBy"        column="unaudit_by"         />
        <result property="unauditTime"      column="unaudit_time"       />
        <result property="createBy"         column="create_by"          />
        <result property="createTime"       column="create_time"        />
        <result property="updateBy"         column="update_by"          />
        <result property="updateTime"       column="update_time"        />
        <result property="remark"           column="remark"             />
    </resultMap>

    <sql id="selectWmsPurchaseReturnVo">
        select purchase_return_id, return_no, return_type, supplier_id, warehouse_id, dept_id, owner_user_id,
               source_bill_type, source_bill_id, source_bill_no, business_date, total_qty, total_amount,
               payable_id, status, biz_status, audit_by, audit_time, is_reversal, origin_bill_id, reversed_flag,
               unaudit_by, unaudit_time, create_by, create_time, update_by, update_time, remark
        from wms_purchase_return
    </sql>

    <select id="selectWmsPurchaseReturnById" parameterType="Long" resultMap="WmsPurchaseReturnResult">
        <include refid="selectWmsPurchaseReturnVo"/>
        where purchase_return_id = #{purchaseReturnId}
    </select>

    <select id="selectWmsPurchaseReturnByIdForUpdate" parameterType="Long" resultMap="WmsPurchaseReturnResult">
        <include refid="selectWmsPurchaseReturnVo"/>
        where purchase_return_id = #{purchaseReturnId}
        for update
    </select>

    <select id="selectWmsPurchaseReturnList" parameterType="WmsPurchaseReturn" resultMap="WmsPurchaseReturnResult">
        <include refid="selectWmsPurchaseReturnVo"/>
        <where>
            <if test="returnNo != null and returnNo != ''">and return_no like concat('%', #{returnNo}, '%')</if>
            <if test="returnType != null and returnType != ''">and return_type = #{returnType}</if>
            <if test="supplierId != null">and supplier_id = #{supplierId}</if>
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
            <if test="sourceBillType != null and sourceBillType != ''">and source_bill_type = #{sourceBillType}</if>
            <if test="sourceBillId != null">and source_bill_id = #{sourceBillId}</if>
            <if test="sourceBillNo != null and sourceBillNo != ''">and source_bill_no like concat('%', #{sourceBillNo}, '%')</if>
            <if test="bizStatus != null and bizStatus != ''">and biz_status = #{bizStatus}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="isReversal != null and isReversal != ''">and is_reversal = #{isReversal}</if>
            ${params.dataScope}
            ${params.warehouseScope}
        </where>
        order by create_time desc
    </select>

    <insert id="insertWmsPurchaseReturn" parameterType="WmsPurchaseReturn" useGeneratedKeys="true" keyProperty="purchaseReturnId">
        insert into wms_purchase_return
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">return_no,</if>
            <if test="returnType != null">return_type,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="ownerUserId != null">owner_user_id,</if>
            <if test="sourceBillType != null">source_bill_type,</if>
            <if test="sourceBillId != null">source_bill_id,</if>
            <if test="sourceBillNo != null and sourceBillNo != ''">source_bill_no,</if>
            <if test="businessDate != null">business_date,</if>
            <if test="totalQty != null">total_qty,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="payableId != null">payable_id,</if>
            <if test="status != null">status,</if>
            <if test="bizStatus != null">biz_status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="isReversal != null">is_reversal,</if>
            <if test="originBillId != null">origin_bill_id,</if>
            <if test="reversedFlag != null">reversed_flag,</if>
            <if test="unauditBy != null">unaudit_by,</if>
            <if test="unauditTime != null">unaudit_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="returnNo != null and returnNo != ''">#{returnNo},</if>
            <if test="returnType != null">#{returnType},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="ownerUserId != null">#{ownerUserId},</if>
            <if test="sourceBillType != null">#{sourceBillType},</if>
            <if test="sourceBillId != null">#{sourceBillId},</if>
            <if test="sourceBillNo != null and sourceBillNo != ''">#{sourceBillNo},</if>
            <if test="businessDate != null">#{businessDate},</if>
            <if test="totalQty != null">#{totalQty},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="payableId != null">#{payableId},</if>
            <if test="status != null">#{status},</if>
            <if test="bizStatus != null">#{bizStatus},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="isReversal != null">#{isReversal},</if>
            <if test="originBillId != null">#{originBillId},</if>
            <if test="reversedFlag != null">#{reversedFlag},</if>
            <if test="unauditBy != null">#{unauditBy},</if>
            <if test="unauditTime != null">#{unauditTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateWmsPurchaseReturn" parameterType="WmsPurchaseReturn">
        update wms_purchase_return
        <set>
            <if test="returnNo != null and returnNo != ''">return_no = #{returnNo},</if>
            <if test="returnType != null">return_type = #{returnType},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="sourceBillType != null">source_bill_type = #{sourceBillType},</if>
            <if test="sourceBillId != null">source_bill_id = #{sourceBillId},</if>
            <if test="sourceBillNo != null and sourceBillNo != ''">source_bill_no = #{sourceBillNo},</if>
            <if test="businessDate != null">business_date = #{businessDate},</if>
            <if test="totalQty != null">total_qty = #{totalQty},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            payable_id = #{payableId},
            <if test="status != null">status = #{status},</if>
            <if test="bizStatus != null">biz_status = #{bizStatus},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            audit_time = #{auditTime},
            <if test="isReversal != null">is_reversal = #{isReversal},</if>
            <if test="originBillId != null">origin_bill_id = #{originBillId},</if>
            <if test="reversedFlag != null">reversed_flag = #{reversedFlag},</if>
            <if test="unauditBy != null">unaudit_by = #{unauditBy},</if>
            <if test="unauditTime != null">unaudit_time = #{unauditTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where purchase_return_id = #{purchaseReturnId}
    </update>

    <delete id="deleteWmsPurchaseReturnById" parameterType="Long">
        delete from wms_purchase_return where purchase_return_id = #{purchaseReturnId}
    </delete>

    <delete id="deleteWmsPurchaseReturnByIds" parameterType="Long">
        delete from wms_purchase_return where purchase_return_id in
        <foreach collection="array" item="purchaseReturnId" open="(" separator="," close=")">
            #{purchaseReturnId}
        </foreach>
    </delete>

    <select id="selectMaxReturnNoByPrefix" parameterType="String" resultType="String">
        select return_no from wms_purchase_return where return_no like concat(#{returnNoPrefix}, '%') order by length(return_no) desc, return_no desc limit 1
    </select>
</mapper>
