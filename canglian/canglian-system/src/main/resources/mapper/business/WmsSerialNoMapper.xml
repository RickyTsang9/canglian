<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.WmsSerialNoMapper">

    <resultMap type="WmsSerialNo" id="WmsSerialNoResult">
        <id property="serialId" column="serial_id" />
        <result property="snCode" column="sn_code" />
        <result property="productId" column="product_id" />
        <result property="warehouseId" column="warehouse_id" />
        <result property="locationId" column="location_id" />
        <result property="batchNo" column="batch_no" />
        <result property="status" column="status" />
        <result property="inboundId" column="inbound_id" />
        <result property="outboundId" column="outbound_id" />
        <result property="customerId" column="customer_id" />
        <result property="warrantyEndDate" column="warranty_end_date" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="updateBy" column="update_by" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <resultMap type="WmsSerialNoLog" id="WmsSerialNoLogResult">
        <id property="snLogId" column="sn_log_id" />
        <result property="serialId" column="serial_id" />
        <result property="snCode" column="sn_code" />
        <result property="actionType" column="action_type" />
        <result property="billType" column="bill_type" />
        <result property="billId" column="bill_id" />
        <result property="billNo" column="bill_no" />
        <result property="warehouseId" column="warehouse_id" />
        <result property="counterpartyId" column="counterparty_id" />
        <result property="remark" column="remark" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectWmsSerialNoVo">
        select serial_id, sn_code, product_id, warehouse_id, location_id, batch_no, status,
               inbound_id, outbound_id, customer_id, warranty_end_date, remark,
               create_by, create_time, update_by, update_time
        from wms_serial_no
    </sql>

    <select id="selectWmsSerialNoById" parameterType="Long" resultMap="WmsSerialNoResult">
        <include refid="selectWmsSerialNoVo"/>
        where serial_id = #{serialId}
    </select>

    <select id="selectWmsSerialNoByCode" parameterType="String" resultMap="WmsSerialNoResult">
        <include refid="selectWmsSerialNoVo"/>
        where sn_code = #{snCode}
        limit 1
    </select>

    <select id="selectWmsSerialNoList" parameterType="WmsSerialNo" resultMap="WmsSerialNoResult">
        <include refid="selectWmsSerialNoVo"/>
        <where>
            <if test="snCode != null and snCode != ''">and sn_code like concat('%', #{snCode}, '%')</if>
            <if test="productId != null">and product_id = #{productId}</if>
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
            <if test="batchNo != null and batchNo != ''">and batch_no like concat('%', #{batchNo}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="customerId != null">and customer_id = #{customerId}</if>
            ${params.warehouseScope}
        </where>
        order by create_time desc, serial_id desc
    </select>

    <insert id="insertWmsSerialNo" parameterType="WmsSerialNo" useGeneratedKeys="true" keyProperty="serialId">
        insert into wms_serial_no
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="snCode != null and snCode != ''">sn_code,</if>
            <if test="productId != null">product_id,</if>
            <if test="warehouseId != null">warehouse_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="status != null">status,</if>
            <if test="inboundId != null">inbound_id,</if>
            <if test="outboundId != null">outbound_id,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="warrantyEndDate != null">warranty_end_date,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="snCode != null and snCode != ''">#{snCode},</if>
            <if test="productId != null">#{productId},</if>
            <if test="warehouseId != null">#{warehouseId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="status != null">#{status},</if>
            <if test="inboundId != null">#{inboundId},</if>
            <if test="outboundId != null">#{outboundId},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="warrantyEndDate != null">#{warrantyEndDate},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
        </trim>
    </insert>

    <update id="updateWmsSerialNo" parameterType="WmsSerialNo">
        update wms_serial_no
        <set>
            <if test="warehouseId != null">warehouse_id = #{warehouseId},</if>
            <if test="locationId != null">location_id = #{locationId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="inboundId != null">inbound_id = #{inboundId},</if>
            <if test="outboundId != null">outbound_id = #{outboundId},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            <if test="warrantyEndDate != null">warranty_end_date = #{warrantyEndDate},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
        </set>
        where serial_id = #{serialId}
    </update>

    <delete id="deleteWmsSerialNoByIds" parameterType="Long">
        delete from wms_serial_no where serial_id in
        <foreach collection="array" item="serialId" open="(" separator="," close=")">
            #{serialId}
        </foreach>
    </delete>

    <insert id="insertWmsSerialNoLog" parameterType="WmsSerialNoLog" useGeneratedKeys="true" keyProperty="snLogId">
        insert into wms_serial_no_log(
            serial_id, sn_code, action_type, bill_type, bill_id, bill_no, warehouse_id, counterparty_id, remark, create_by, create_time
        )
        values(
            #{serialId}, #{snCode}, #{actionType}, #{billType}, #{billId}, #{billNo}, #{warehouseId}, #{counterpartyId}, #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <select id="selectLogsBySnCode" parameterType="String" resultMap="WmsSerialNoLogResult">
        select sn_log_id, serial_id, sn_code, action_type, bill_type, bill_id, bill_no,
               warehouse_id, counterparty_id, remark, create_by, create_time
        from wms_serial_no_log
        where sn_code = #{snCode}
        order by create_time asc, sn_log_id asc
    </select>
</mapper>
