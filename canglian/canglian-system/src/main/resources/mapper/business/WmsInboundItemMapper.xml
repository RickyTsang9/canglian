<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.WmsInboundItemMapper">

    <resultMap type="WmsInboundItem" id="WmsInboundItemResult">
        <id     property="inboundItemId"  column="inbound_item_id" />
        <result property="inboundId"      column="inbound_id"      />
        <result property="sourceItemId"   column="source_item_id"  />
        <result property="productId"      column="product_id"      />
        <result property="locationId"     column="location_id"     />
        <result property="batchNo"        column="batch_no"        />
        <result property="unitName"       column="unit_name"       />
        <result property="convertRatio"   column="convert_ratio"   />
        <result property="baseQuantity"   column="base_quantity"   />
        <result property="productionDate" column="production_date" />
        <result property="expiryDate"     column="expiry_date"     />
        <result property="quantity"       column="quantity"        />
        <result property="price"          column="price"           />
        <result property="discountRate"   column="discount_rate"   />
        <result property="taxRate"        column="tax_rate"        />
        <result property="taxAmount"      column="tax_amount"      />
        <result property="amount"         column="amount"          />
        <result property="snCodes"        column="sn_codes"        />
    </resultMap>

    <sql id="selectWmsInboundItemVo">
        select inbound_item_id, inbound_id, source_item_id, product_id, location_id, batch_no,
               unit_name, convert_ratio, base_quantity, production_date, expiry_date,
               quantity, price, discount_rate, tax_rate, tax_amount, amount, sn_codes
        from wms_inbound_item
    </sql>

    <select id="selectWmsInboundItemById" parameterType="Long" resultMap="WmsInboundItemResult">
        <include refid="selectWmsInboundItemVo"/>
        where inbound_item_id = #{inboundItemId}
    </select>

    <select id="selectWmsInboundItemList" parameterType="WmsInboundItem" resultMap="WmsInboundItemResult">
        <include refid="selectWmsInboundItemVo"/>
        <where>
            <if test="inboundId != null">and inbound_id = #{inboundId}</if>
            <if test="sourceItemId != null">and source_item_id = #{sourceItemId}</if>
            <if test="productId != null">and product_id = #{productId}</if>
            <if test="locationId != null">and location_id = #{locationId}</if>
            <if test="batchNo != null and batchNo != ''">and batch_no = #{batchNo}</if>
        </where>
    </select>

    <insert id="insertWmsInboundItem" parameterType="WmsInboundItem" useGeneratedKeys="true" keyProperty="inboundItemId">
        insert into wms_inbound_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="inboundId != null">inbound_id,</if>
            <if test="sourceItemId != null">source_item_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="unitName != null">unit_name,</if>
            <if test="convertRatio != null">convert_ratio,</if>
            <if test="baseQuantity != null">base_quantity,</if>
            <if test="productionDate != null">production_date,</if>
            <if test="expiryDate != null">expiry_date,</if>
            <if test="quantity != null">quantity,</if>
            <if test="price != null">price,</if>
            <if test="discountRate != null">discount_rate,</if>
            <if test="taxRate != null">tax_rate,</if>
            <if test="taxAmount != null">tax_amount,</if>
            <if test="amount != null">amount,</if>
            <if test="snCodes != null">sn_codes,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="inboundId != null">#{inboundId},</if>
            <if test="sourceItemId != null">#{sourceItemId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="unitName != null">#{unitName},</if>
            <if test="convertRatio != null">#{convertRatio},</if>
            <if test="baseQuantity != null">#{baseQuantity},</if>
            <if test="productionDate != null">#{productionDate},</if>
            <if test="expiryDate != null">#{expiryDate},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="price != null">#{price},</if>
            <if test="discountRate != null">#{discountRate},</if>
            <if test="taxRate != null">#{taxRate},</if>
            <if test="taxAmount != null">#{taxAmount},</if>
            <if test="amount != null">#{amount},</if>
            <if test="snCodes != null">#{snCodes},</if>
        </trim>
    </insert>

    <update id="updateWmsInboundItem" parameterType="WmsInboundItem">
        update wms_inbound_item
        <set>
            <if test="inboundId != null">inbound_id = #{inboundId},</if>
            <if test="sourceItemId != null">source_item_id = #{sourceItemId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="locationId != null">location_id = #{locationId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="unitName != null">unit_name = #{unitName},</if>
            <if test="convertRatio != null">convert_ratio = #{convertRatio},</if>
            <if test="baseQuantity != null">base_quantity = #{baseQuantity},</if>
            <if test="productionDate != null">production_date = #{productionDate},</if>
            <if test="expiryDate != null">expiry_date = #{expiryDate},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="price != null">price = #{price},</if>
            <if test="discountRate != null">discount_rate = #{discountRate},</if>
            <if test="taxRate != null">tax_rate = #{taxRate},</if>
            <if test="taxAmount != null">tax_amount = #{taxAmount},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="snCodes != null">sn_codes = #{snCodes},</if>
        </set>
        where inbound_item_id = #{inboundItemId}
    </update>

    <delete id="deleteWmsInboundItemById" parameterType="Long">
        delete from wms_inbound_item where inbound_item_id = #{inboundItemId}
    </delete>

    <delete id="deleteWmsInboundItemByIds" parameterType="Long">
        delete from wms_inbound_item where inbound_item_id in
        <foreach collection="array" item="inboundItemId" open="(" separator="," close=")">
            #{inboundItemId}
        </foreach>
    </delete>

    <delete id="deleteWmsInboundItemByInboundId" parameterType="Long">
        delete from wms_inbound_item where inbound_id = #{inboundId}
    </delete>
</mapper>
