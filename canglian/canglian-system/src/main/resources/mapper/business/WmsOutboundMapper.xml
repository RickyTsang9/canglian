    <sql id="selectWmsOutboundVo">
        select outbound_id, outbound_no, outbound_type, customer_id, warehouse_id, dept_id, owner_user_id,
               source_bill_type, source_bill_id, source_bill_no, business_date, total_qty, total_amount,
               discount_amount, tax_total_amount, verified_flag, verified_by, verified_time,
               status, biz_status, audit_by, audit_time, is_reversal, origin_bill_id, reversed_flag,
               unaudit_by, unaudit_time, platform_type, store_id, source_order_no,
               carrier, waybill_no, freight_cost, delivery_status, create_by, create_time, update_by, update_time, remark
        from wms_outbound
    </sql>

    <select id="selectWmsOutboundById" parameterType="Long" resultMap="WmsOutboundResult">
        <include refid="selectWmsOutboundVo"/>
        where outbound_id = #{outboundId}
    </select>

    <select id="selectWmsOutboundByIdForUpdate" parameterType="Long" resultMap="WmsOutboundResult">
        <include refid="selectWmsOutboundVo"/>
        where outbound_id = #{outboundId}
        for update
    </select>

    <select id="selectWmsOutboundList" parameterType="WmsOutbound" resultMap="WmsOutboundResult">
        <include refid="selectWmsOutboundVo"/>
        <where>
            <if test="outboundNo != null and outboundNo != ''">and outbound_no like concat('%', #{outboundNo}, '%')</if>
            <if test="outboundType != null and outboundType != ''">and outbound_type = #{outboundType}</if>
            <if test="customerId != null">and customer_id = #{customerId}</if>
            <if test="warehouseId != null">and warehouse_id = #{warehouseId}</if>
            <if test="sourceBillType != null and sourceBillType != ''">and source_bill_type = #{sourceBillType}</if>
            <if test="sourceBillId != null">and source_bill_id = #{sourceBillId}</if>
            <if test="sourceBillNo != null and sourceBillNo != ''">and source_bill_no like concat('%', #{sourceBillNo}, '%')</if>
            <if test="platformType != null and platformType != ''">and platform_type = #{platformType}</if>
            <if test="storeId != null">and store_id = #{storeId}</if>
            <if test="sourceOrderNo != null and sourceOrderNo != ''">and source_order_no like concat('%', #{sourceOrderNo}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="bizStatus != null and bizStatus != ''">and biz_status = #{bizStatus}</if>
            <if test="deliveryStatus != null and deliveryStatus != ''">and delivery_status = #{deliveryStatus}</if>
            <if test="isReversal != null and isReversal != ''">and is_reversal = #{isReversal}</if>
            ${params.dataScope}
            ${params.warehouseScope}
        </where>
        order by create_time desc
    </select>

