<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.FinOffsetLogMapper">

    <resultMap type="FinOffsetLog" id="FinOffsetLogResult">
        <id property="offsetId" column="offset_id" />
        <result property="offsetType" column="offset_type" />
        <result property="positiveBillId" column="positive_bill_id" />
        <result property="redBillId" column="red_bill_id" />
        <result property="offsetAmount" column="offset_amount" />
        <result property="status" column="status" />
        <result property="createBy" column="create_by" />
        <result property="createTime" column="create_time" />
        <result property="reverseBy" column="reverse_by" />
        <result property="reverseTime" column="reverse_time" />
        <result property="remark" column="remark" />
    </resultMap>

    <sql id="selectFinOffsetLogVo">
        select offset_id, offset_type, positive_bill_id, red_bill_id, offset_amount, status,
               create_by, create_time, reverse_by, reverse_time, remark
        from fin_offset_log
    </sql>

    <select id="selectFinOffsetLogById" parameterType="Long" resultMap="FinOffsetLogResult">
        <include refid="selectFinOffsetLogVo"/>
        where offset_id = #{offsetId}
    </select>

    <select id="selectFinOffsetLogList" parameterType="FinOffsetLog" resultMap="FinOffsetLogResult">
        <include refid="selectFinOffsetLogVo"/>
        <where>
            <if test="offsetType != null and offsetType != ''">
                and offset_type = #{offsetType}
            </if>
            <if test="positiveBillId != null">
                and positive_bill_id = #{positiveBillId}
            </if>
            <if test="redBillId != null">
                and red_bill_id = #{redBillId}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by offset_id desc
    </select>

    <insert id="insertFinOffsetLog" parameterType="FinOffsetLog" useGeneratedKeys="true" keyProperty="offsetId">
        insert into fin_offset_log (
            offset_type, positive_bill_id, red_bill_id, offset_amount, status,
            create_by, create_time, remark
        ) values (
            #{offsetType}, #{positiveBillId}, #{redBillId}, #{offsetAmount}, coalesce(#{status}, '0'),
            #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateFinOffsetLog" parameterType="FinOffsetLog">
        update fin_offset_log
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reverseBy != null">reverse_by = #{reverseBy},</if>
            <if test="reverseTime != null">reverse_time = #{reverseTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where offset_id = #{offsetId}
    </update>
</mapper>
