<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.WmsTransferMapper">

    <resultMap type="WmsTransfer" id="WmsTransferResult">
        <id     property="transferId"     column="transfer_id"      />
        <result property="transferNo"     column="transfer_no"      />
        <result property="outWarehouseId" column="out_warehouse_id" />
        <result property="inWarehouseId"  column="in_warehouse_id"  />
        <result property="businessDate"   column="business_date"    />
        <result property="deptId"         column="dept_id"          />
        <result property="ownerUserId"    column="owner_user_id"    />
        <result property="totalQty"       column="total_qty"        />
        <result property="totalAmount"    column="total_amount"     />
        <result property="status"         column="status"           />
        <result property="isReversal"     column="is_reversal"      />
        <result property="originBillId"   column="origin_bill_id"   />
        <result property="reversedFlag"   column="reversed_flag"    />
        <result property="unauditBy"      column="unaudit_by"       />
        <result property="unauditTime"    column="unaudit_time"     />
        <result property="createBy"       column="create_by"        />
        <result property="createTime"     column="create_time"      />
        <result property="updateBy"       column="update_by"        />
        <result property="updateTime"     column="update_time"      />
        <result property="remark"         column="remark"           />
    </resultMap>

    <sql id="selectWmsTransferVo">
        select transfer_id, transfer_no, out_warehouse_id, in_warehouse_id, business_date, dept_id, owner_user_id,
               total_qty, total_amount, status, is_reversal, origin_bill_id, reversed_flag,
               unaudit_by, unaudit_time, create_by, create_time, update_by, update_time, remark
        from wms_transfer
    </sql>

    <select id="selectWmsTransferById" parameterType="Long" resultMap="WmsTransferResult">
        <include refid="selectWmsTransferVo"/>
        where transfer_id = #{transferId}
    </select>

    <select id="selectWmsTransferByIdForUpdate" parameterType="Long" resultMap="WmsTransferResult">
        <include refid="selectWmsTransferVo"/>
        where transfer_id = #{transferId}
        for update
    </select>

    <select id="selectWmsTransferList" parameterType="WmsTransfer" resultMap="WmsTransferResult">
        <include refid="selectWmsTransferVo"/>
        <where>
            <if test="transferNo != null and transferNo != ''">and transfer_no like concat('%', #{transferNo}, '%')</if>
            <if test="outWarehouseId != null">and out_warehouse_id = #{outWarehouseId}</if>
            <if test="inWarehouseId != null">and in_warehouse_id = #{inWarehouseId}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="isReversal != null and isReversal != ''">and is_reversal = #{isReversal}</if>
            ${params.dataScope}
            ${params.warehouseScope}
        </where>
        order by create_time desc
    </select>

    <insert id="insertWmsTransfer" parameterType="WmsTransfer" useGeneratedKeys="true" keyProperty="transferId">
        insert into wms_transfer
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="transferNo != null and transferNo != ''">transfer_no,</if>
            <if test="outWarehouseId != null">out_warehouse_id,</if>
            <if test="inWarehouseId != null">in_warehouse_id,</if>
            <if test="businessDate != null">business_date,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="ownerUserId != null">owner_user_id,</if>
            <if test="totalQty != null">total_qty,</if>
            <if test="totalAmount != null">total_amount,</if>
            <if test="status != null">status,</if>
            <if test="isReversal != null">is_reversal,</if>
            <if test="originBillId != null">origin_bill_id,</if>
            <if test="reversedFlag != null">reversed_flag,</if>
            <if test="unauditBy != null">unaudit_by,</if>
            <if test="unauditTime != null">unaudit_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="transferNo != null and transferNo != ''">#{transferNo},</if>
            <if test="outWarehouseId != null">#{outWarehouseId},</if>
            <if test="inWarehouseId != null">#{inWarehouseId},</if>
            <if test="businessDate != null">#{businessDate},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="ownerUserId != null">#{ownerUserId},</if>
            <if test="totalQty != null">#{totalQty},</if>
            <if test="totalAmount != null">#{totalAmount},</if>
            <if test="status != null">#{status},</if>
            <if test="isReversal != null">#{isReversal},</if>
            <if test="originBillId != null">#{originBillId},</if>
            <if test="reversedFlag != null">#{reversedFlag},</if>
            <if test="unauditBy != null">#{unauditBy},</if>
            <if test="unauditTime != null">#{unauditTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateWmsTransfer" parameterType="WmsTransfer">
        update wms_transfer
        <set>
            <if test="transferNo != null and transferNo != ''">transfer_no = #{transferNo},</if>
            <if test="outWarehouseId != null">out_warehouse_id = #{outWarehouseId},</if>
            <if test="inWarehouseId != null">in_warehouse_id = #{inWarehouseId},</if>
            <if test="businessDate != null">business_date = #{businessDate},</if>
            <if test="totalQty != null">total_qty = #{totalQty},</if>
            <if test="totalAmount != null">total_amount = #{totalAmount},</if>
            <if test="status != null">status = #{status},</if>
            <if test="isReversal != null">is_reversal = #{isReversal},</if>
            <if test="originBillId != null">origin_bill_id = #{originBillId},</if>
            <if test="reversedFlag != null">reversed_flag = #{reversedFlag},</if>
            <if test="unauditBy != null">unaudit_by = #{unauditBy},</if>
            <if test="unauditTime != null">unaudit_time = #{unauditTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where transfer_id = #{transferId}
    </update>

    <delete id="deleteWmsTransferById" parameterType="Long">
        delete from wms_transfer where transfer_id = #{transferId}
    </delete>

    <delete id="deleteWmsTransferByIds" parameterType="Long">
        delete from wms_transfer where transfer_id in
        <foreach collection="array" item="transferId" open="(" separator="," close=")">
            #{transferId}
        </foreach>
    </delete>

    <select id="selectMaxTransferNoByPrefix" parameterType="String" resultType="String">
        select transfer_no from wms_transfer where transfer_no like concat(#{noPrefix}, '%') order by length(transfer_no) desc, transfer_no desc limit 1
    </select>
</mapper>
