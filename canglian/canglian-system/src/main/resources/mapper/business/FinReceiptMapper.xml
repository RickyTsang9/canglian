<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.FinReceiptMapper">

    <resultMap type="FinReceipt" id="FinReceiptResult">
        <id     property="receiptId"     column="receipt_id"      />
        <result property="receiptNo"     column="receipt_no"      />
        <result property="customerId"    column="customer_id"     />
        <result property="receivableId"  column="receivable_id"   />
        <result property="fundAccountId" column="fund_account_id" />
        <result property="deptId"        column="dept_id"         />
        <result property="ownerUserId"   column="owner_user_id"   />
        <result property="amount"        column="amount"          />
        <result property="receiptDate"   column="receipt_date"    />
        <result property="payChannel"    column="pay_channel"     />
        <result property="status"        column="status"          />
        <result property="bizStatus"     column="biz_status"      />
        <result property="auditBy"       column="audit_by"        />
        <result property="auditTime"     column="audit_time"      />
        <result property="createBy"      column="create_by"       />
        <result property="createTime"    column="create_time"     />
        <result property="updateBy"      column="update_by"       />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"        column="remark"          />
    </resultMap>

    <sql id="selectFinReceiptVo">
        select receipt_id, receipt_no, customer_id, receivable_id, fund_account_id, dept_id, owner_user_id,
               amount, receipt_date, pay_channel, status, biz_status, audit_by, audit_time,
               create_by, create_time, update_by, update_time, remark
        from fin_receipt
    </sql>

    <select id="selectFinReceiptById" parameterType="Long" resultMap="FinReceiptResult">
        <include refid="selectFinReceiptVo"/>
        where receipt_id = #{receiptId}
    </select>

    <select id="selectFinReceiptList" parameterType="FinReceipt" resultMap="FinReceiptResult">
        <include refid="selectFinReceiptVo"/>
        <where>
            <if test="receiptNo != null and receiptNo != ''">and receipt_no like concat('%', #{receiptNo}, '%')</if>
            <if test="customerId != null">and customer_id = #{customerId}</if>
            <if test="receivableId != null">and receivable_id = #{receivableId}</if>
            <if test="fundAccountId != null">and fund_account_id = #{fundAccountId}</if>
            <if test="payChannel != null and payChannel != ''">and pay_channel = #{payChannel}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
            <if test="bizStatus != null and bizStatus != ''">and biz_status = #{bizStatus}</if>
            ${params.dataScope}
        </where>
        order by create_time desc, receipt_id desc
    </select>

    <select id="selectMaxReceiptNoByPrefix" parameterType="String" resultType="String">
        select receipt_no from fin_receipt where receipt_no like concat(#{receiptNoPrefix}, '%') order by length(receipt_no) desc, receipt_no desc limit 1
    </select>

    <insert id="insertFinReceipt" parameterType="FinReceipt" useGeneratedKeys="true" keyProperty="receiptId">
        insert into fin_receipt
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="receiptNo != null and receiptNo != ''">receipt_no,</if>
            <if test="customerId != null">customer_id,</if>
            <if test="receivableId != null">receivable_id,</if>
            <if test="fundAccountId != null">fund_account_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="ownerUserId != null">owner_user_id,</if>
            <if test="amount != null">amount,</if>
            <if test="receiptDate != null">receipt_date,</if>
            <if test="payChannel != null">pay_channel,</if>
            <if test="status != null">status,</if>
            <if test="bizStatus != null">biz_status,</if>
            <if test="auditBy != null">audit_by,</if>
            <if test="auditTime != null">audit_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time,
            <if test="updateBy != null and updateBy != ''">update_by,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="receiptNo != null and receiptNo != ''">#{receiptNo},</if>
            <if test="customerId != null">#{customerId},</if>
            <if test="receivableId != null">#{receivableId},</if>
            <if test="fundAccountId != null">#{fundAccountId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="ownerUserId != null">#{ownerUserId},</if>
            <if test="amount != null">#{amount},</if>
            <if test="receiptDate != null">#{receiptDate},</if>
            <if test="payChannel != null">#{payChannel},</if>
            <if test="status != null">#{status},</if>
            <if test="bizStatus != null">#{bizStatus},</if>
            <if test="auditBy != null">#{auditBy},</if>
            <if test="auditTime != null">#{auditTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate(),
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateFinReceipt" parameterType="FinReceipt">
        update fin_receipt
        <set>
            <if test="receiptNo != null and receiptNo != ''">receipt_no = #{receiptNo},</if>
            <if test="customerId != null">customer_id = #{customerId},</if>
            receivable_id = #{receivableId},
            fund_account_id = #{fundAccountId},
            <if test="amount != null">amount = #{amount},</if>
            <if test="receiptDate != null">receipt_date = #{receiptDate},</if>
            <if test="payChannel != null">pay_channel = #{payChannel},</if>
            <if test="status != null">status = #{status},</if>
            <if test="bizStatus != null">biz_status = #{bizStatus},</if>
            <if test="auditBy != null">audit_by = #{auditBy},</if>
            audit_time = #{auditTime},
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate(),
            <if test="remark != null">remark = #{remark},</if>
        </set>
        where receipt_id = #{receiptId}
    </update>

    <delete id="deleteFinReceiptById" parameterType="Long">
        delete from fin_receipt where receipt_id = #{receiptId}
    </delete>

    <delete id="deleteFinReceiptByIds" parameterType="Long">
        delete from fin_receipt where receipt_id in
        <foreach collection="array" item="receiptId" open="(" separator="," close=")">
            #{receiptId}
        </foreach>
    </delete>
</mapper>
