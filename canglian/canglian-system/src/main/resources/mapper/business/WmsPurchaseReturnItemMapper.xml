<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.canglian.business.mapper.WmsPurchaseReturnItemMapper">

    <resultMap type="WmsPurchaseReturnItem" id="WmsPurchaseReturnItemResult">
        <id     property="purchaseReturnItemId" column="purchase_return_item_id" />
        <result property="purchaseReturnId"     column="purchase_return_id" />
        <result property="productId"            column="product_id" />
        <result property="locationId"           column="location_id" />
        <result property="batchNo"              column="batch_no" />
        <result property="unitName"             column="unit_name" />
        <result property="convertRatio"         column="convert_ratio" />
        <result property="baseQuantity"         column="base_quantity" />
        <result property="productionDate"       column="production_date" />
        <result property="expiryDate"           column="expiry_date" />
        <result property="snCodes"              column="sn_codes" />
        <result property="deductTrace"          column="deduct_trace" />
        <result property="quantity"             column="quantity" />
        <result property="price"                column="price" />
        <result property="amount"               column="amount" />
    </resultMap>

    <sql id="selectWmsPurchaseReturnItemVo">
        select purchase_return_item_id, purchase_return_id, product_id, location_id, batch_no,
               unit_name, convert_ratio, base_quantity, production_date, expiry_date, sn_codes, deduct_trace,
               quantity, price, amount
        from wms_purchase_return_item
    </sql>

    <select id="selectWmsPurchaseReturnItemById" parameterType="Long" resultMap="WmsPurchaseReturnItemResult">
        <include refid="selectWmsPurchaseReturnItemVo"/>
        where purchase_return_item_id = #{purchaseReturnItemId}
    </select>

    <select id="selectWmsPurchaseReturnItemList" parameterType="WmsPurchaseReturnItem" resultMap="WmsPurchaseReturnItemResult">
        <include refid="selectWmsPurchaseReturnItemVo"/>
        <where>
            <if test="purchaseReturnId != null">and purchase_return_id = #{purchaseReturnId}</if>
            <if test="productId != null">and product_id = #{productId}</if>
        </where>
    </select>

    <insert id="insertWmsPurchaseReturnItem" parameterType="WmsPurchaseReturnItem" useGeneratedKeys="true" keyProperty="purchaseReturnItemId">
        insert into wms_purchase_return_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="purchaseReturnId != null">purchase_return_id,</if>
            <if test="productId != null">product_id,</if>
            <if test="locationId != null">location_id,</if>
            <if test="batchNo != null">batch_no,</if>
            <if test="unitName != null">unit_name,</if>
            <if test="convertRatio != null">convert_ratio,</if>
            <if test="baseQuantity != null">base_quantity,</if>
            <if test="productionDate != null">production_date,</if>
            <if test="expiryDate != null">expiry_date,</if>
            <if test="snCodes != null">sn_codes,</if>
            <if test="deductTrace != null">deduct_trace,</if>
            <if test="quantity != null">quantity,</if>
            <if test="price != null">price,</if>
            <if test="amount != null">amount,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="purchaseReturnId != null">#{purchaseReturnId},</if>
            <if test="productId != null">#{productId},</if>
            <if test="locationId != null">#{locationId},</if>
            <if test="batchNo != null">#{batchNo},</if>
            <if test="unitName != null">#{unitName},</if>
            <if test="convertRatio != null">#{convertRatio},</if>
            <if test="baseQuantity != null">#{baseQuantity},</if>
            <if test="productionDate != null">#{productionDate},</if>
            <if test="expiryDate != null">#{expiryDate},</if>
            <if test="snCodes != null">#{snCodes},</if>
            <if test="deductTrace != null">#{deductTrace},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="price != null">#{price},</if>
            <if test="amount != null">#{amount},</if>
        </trim>
    </insert>

    <update id="updateWmsPurchaseReturnItem" parameterType="WmsPurchaseReturnItem">
        update wms_purchase_return_item
        <set>
            <if test="purchaseReturnId != null">purchase_return_id = #{purchaseReturnId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="locationId != null">location_id = #{locationId},</if>
            <if test="batchNo != null">batch_no = #{batchNo},</if>
            <if test="unitName != null">unit_name = #{unitName},</if>
            <if test="convertRatio != null">convert_ratio = #{convertRatio},</if>
            <if test="baseQuantity != null">base_quantity = #{baseQuantity},</if>
            <if test="productionDate != null">production_date = #{productionDate},</if>
            <if test="expiryDate != null">expiry_date = #{expiryDate},</if>
            <if test="snCodes != null">sn_codes = #{snCodes},</if>
            <if test="deductTrace != null">deduct_trace = #{deductTrace},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="price != null">price = #{price},</if>
            <if test="amount != null">amount = #{amount},</if>
        </set>
        where purchase_return_item_id = #{purchaseReturnItemId}
    </update>

    <delete id="deleteWmsPurchaseReturnItemByPurchaseReturnId" parameterType="Long">
        delete from wms_purchase_return_item where purchase_return_id = #{purchaseReturnId}
    </delete>

    <delete id="deleteWmsPurchaseReturnItemById" parameterType="Long">
        delete from wms_purchase_return_item where purchase_return_item_id = #{purchaseReturnItemId}
    </delete>

    <delete id="deleteWmsPurchaseReturnItemByIds" parameterType="Long">
        delete from wms_purchase_return_item where purchase_return_item_id in
        <foreach collection="array" item="purchaseReturnItemId" open="(" separator="," close=")">
            #{purchaseReturnItemId}
        </foreach>
    </delete>
</mapper>
